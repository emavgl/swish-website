---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const playUrl = 'https://play.google.com/store/apps/details?id=eu.viglianisi.swish';

const features = [
  {
    title: 'One thumb, one minute',
    body: 'Swipe up to shoot. The way you swipe sets the direction. The length of the swipe sets the power. No buttons.',
  },
  {
    title: 'The hoop waits for you',
    body: 'The hoop stays still while the ball is in the air. Then it jumps to a new place for the next shot.',
  },
  {
    title: 'Combos and clean shots',
    body: 'Score again and again to raise your multiplier up to ×5. A clean shot is worth more than one that hits the rim.',
  },
  {
    title: 'Trick shots pay more',
    body: 'If the ball bounces off a side wall and still goes in, that basket is worth more: ×2, ×3 or ×4. It adds up with your combo.',
  },
  {
    title: 'Endless levels',
    body: 'Each level asks for more points in 60 seconds. Reach the target and the next level starts right away. There is no last level.',
  },
  {
    title: 'Small and offline',
    body: 'No ads, no purchases, no account, no internet. The game runs on your phone.',
  },
];
---

<Layout title="SWISH – Sixty seconds, one hoop">
  <canvas class="dot-field" aria-hidden="true"></canvas>

  <section class="hero">
    <div class="container">
      <p class="eyebrow">A 60-second basketball game</p>
      <h1>SW<span class="accent">I</span>SH</h1>
      <p class="lede">Sixty seconds, one hoop. Flick the ball into the basket, keep scoring to build a combo, and bounce the ball off the walls for extra points.</p>
      <div class="actions">
        <a class="button button-primary" href={playUrl} target="_blank" rel="noopener">Get it on Google Play</a>
        <a class="button button-secondary" href={`${base}#how-to-play`}>How to play</a>
      </div>
      <p class="hero-note">Free · no ads · works offline</p>
    </div>
  </section>

  <div class="shots">
    <img src={`${base}screenshots/1-cover.jpg`} alt="SWISH cover: a basketball flying towards a hoop" width="1080" height="1920" loading="lazy" />
    <img src={`${base}screenshots/2-trick-shots.jpg`} alt="SWISH gameplay: a basket with a combo and a wall-bounce multiplier" width="1080" height="1920" loading="lazy" />
    <img src={`${base}screenshots/3-aim.jpg`} alt="SWISH gameplay: aiming at the hoop while the ball is in the air" width="1080" height="1920" loading="lazy" />
  </div>

  <section class="section" id="how-to-play">
    <div class="container">
      <div class="section-heading">
        <h2>Easy to learn.</h2>
        <p>One swipe to shoot. The rest is about where the hoop is and how hard you swipe.</p>
      </div>
      <div class="feature-grid">
        {features.map((f) => (
          <article class="feature-card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container narrow">
      <div class="section-heading">
        <h2>How a shot works</h2>
        <p>Aim, swipe, score.</p>
      </div>
      <div class="prose" style="margin: 0 auto;">
        <ol>
          <li>Swipe up in the lower half of the screen to shoot.</li>
          <li>Swipe straight to shoot straight. Tilt the swipe to aim left or right.</li>
          <li>Swipe longer for more power. A short swipe falls short.</li>
          <li>The hoop does not move while the ball is in the air. Aim at the hoop you see.</li>
          <li>A basket is 2 points. A clean shot is 3. Score again and again to raise the multiplier, up to ×5.</li>
          <li>Every bounce on a side wall makes the basket worth more: ×2, ×3, ×4. It adds up with your combo.</li>
          <li>Reach the level target before time runs out and the next level starts. There is no last level.</li>
        </ol>
        <p>The clock starts when you take your first shot, so you can get ready without hurry.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Simple rules.</h2>
        <p>No ads, no purchases, no accounts. Just the hoop.</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <h3>The timer</h3>
          <p>You get 60 seconds per level. The clock starts on your first shot. Tap the pause button in the top-left corner to stop.</p>
        </article>
        <article class="feature-card">
          <h3>How to swipe</h3>
          <p>A short swipe is a soft shot. A long swipe is a strong, high shot. If the ball falls short, swipe a little longer.</p>
        </article>
        <article class="feature-card">
          <h3>Your progress</h3>
          <p>The level you unlocked is saved on your phone. If you clear the app data or reinstall, it starts again from level 1.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <h2>How many baskets can you score in a minute?</h2>
        <p>Download SWISH and find out.</p>
      </div>
      <a class="button button-primary" href={playUrl} target="_blank" rel="noopener">Google Play</a>
    </div>
  </section>
</Layout>

<script>
  // Slow drifting dots, the same ambient language the game uses on its court.
  const canvas = document.querySelector<HTMLCanvasElement>('.dot-field');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Dot = { x: number; y: number; r: number; phase: number; speed: number; sway: number; alpha: number };
    let width = 0;
    let height = 0;
    let dots: Dot[] = [];

    const seed = () => {
      const count = Math.max(10, Math.min(34, Math.round((width * height) / 55000)));
      dots = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: 1.6 + Math.random() * 3.4,
        phase: Math.random() * Math.PI * 2,
        speed: 0.08 + Math.random() * 0.22,
        sway: 8 + Math.random() * 22,
        alpha: 0.05 + Math.random() * 0.08,
      }));
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const nextWidth = window.innerWidth;
      const nextHeight = window.innerHeight;
      if (nextWidth === width && nextHeight === height) return;
      width = nextWidth;
      height = nextHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    };

    const draw = (t: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      for (const dot of dots) {
        const x = dot.x + Math.sin(t * dot.speed + dot.phase) * dot.sway;
        const y = dot.y + Math.cos(t * dot.speed * 0.7 + dot.phase) * dot.sway * 0.6;
        ctx.fillStyle = `rgba(242, 106, 43, ${dot.alpha})`;
        ctx.beginPath();
        ctx.arc(x, y, dot.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    resize();
    window.addEventListener('resize', resize);

    if (reduceMotion) {
      draw(0);
    } else {
      let last = performance.now();
      let elapsed = 0;
      const tick = (now: number) => {
        elapsed += Math.min((now - last) / 1000, 0.05);
        last = now;
        draw(elapsed);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
