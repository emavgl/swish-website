---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const playUrl = 'https://play.google.com/store/apps/details?id=eu.viglianisi.swish';

const faqs = [
  {
    q: 'How do I play?',
    a: 'Swipe up in the lower part of the screen to flick the ball. The direction of the swipe sets the angle, the length sets the power. Aim at the ring you can see — it stays still while the ball is in the air.',
  },
  {
    q: 'Why did my shot miss even though it looked straight?',
    a: 'The ball is thrown, not steered: the ring is ahead of you and the shot keeps the angle you gave it. A short flick falls short, a wide flick goes wide. The trick is a committed swipe roughly towards the hoop, leaning just enough to line up with the rim.',
  },
  {
    q: 'The timer is not moving. Is the game stuck?',
    a: 'No: the clock only starts when you release your first shot. Before that you have all the time you want to line up the opener. Pause is the small button in the top-left corner.',
  },
  {
    q: 'How do the multipliers work?',
    a: 'Consecutive baskets build a combo up to ×5. A clean swish (no rim contact) is worth 3 base points instead of 2. Every bounce off the side wall multiplies that basket again — ×2 for one touch, ×3 for three, and so on — stacking on top of your combo.',
  },
  {
    q: 'Can I lose progress?',
    a: 'Your unlocked level is saved on your phone. Clearing the app data, or uninstalling the game, resets it. There is no cloud save and no account.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, completely. SWISH has no internet permission, no ads, no analytics and no in-app purchases.',
  },
  {
    q: 'Which devices are supported?',
    a: 'Android 7.0 and newer on a 64-bit (arm64) device. The game runs full screen in portrait.',
  },
  {
    q: 'How do I turn off vibration?',
    a: 'SWISH vibrates only on a basket, a rim hit and the final buzzer. You can turn game vibration off in Android Settings → Sounds and vibration → System vibration (the exact path depends on your phone).',
  },
];
---
<Layout title="Support – SWISH" description="Help, frequently asked questions and contact details for the SWISH basketball game.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Support</p>
      <h1>How can we help?</h1>
      <p class="lede">Answers to the usual questions, and a way to reach a human.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2 style="margin-top: 0;">Frequently asked</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <h2>Report a bug or ask for a feature</h2>
      <p>Email is the fastest way. Please include your phone model, Android version and what happened just before the problem. Screenshots are welcome.</p>
      <div class="contact-card">
        <div>
          <h2>Write to us</h2>
          <p>Usually answered within a couple of days.</p>
        </div>
        <a class="button button-primary" href="mailto:emavgl.app@gmail.com?subject=SWISH%20support">emavgl.app@gmail.com</a>
      </div>

      <h2>Useful links</h2>
      <ul>
        <li><a href={playUrl} target="_blank" rel="noopener">SWISH on Google Play</a></li>
        <li><a href={`${base}privacy-policy/`}>Privacy policy</a> — everything stays on your phone</li>
        <li><a href={`${base}data-safety/`}>Data safety</a> — the Play summary in plain words</li>
        <li><a href={`${base}content-rating/`}>Content rating</a> — what the game contains</li>
        <li><a href={`${base}impressum/`}>Impressum</a> — who publishes the game</li>
      </ul>

      <p class="small-note">SWISH is developed by Emanuele Viglianisi, Leonding, Austria.</p>
    </div>
  </section>
</Layout>
