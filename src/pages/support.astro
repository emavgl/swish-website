---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const playUrl = 'https://play.google.com/store/apps/details?id=eu.viglianisi.swish';

const faqs = [
  {
    q: 'How do I play?',
    a: 'Swipe up in the lower part of the screen to shoot. The way you swipe sets the direction. The length of the swipe sets the power.',
  },
  {
    q: 'Why does my shot miss?',
    a: 'The ball goes where you throw it. If the shot falls short, swipe a little longer. If it goes wide, swipe a little straighter. Aim at the hoop you see, because it does not move while the ball is in the air.',
  },
  {
    q: 'The timer is not moving. Is the game stuck?',
    a: 'No. The clock starts when you take your first shot. Before that it stays still so you can get ready. To stop the game, tap the pause button in the top-left corner.',
  },
  {
    q: 'How do the multipliers work?',
    a: 'Score again and again to raise your combo, up to ×5. A clean shot (no rim) is worth 3 points instead of 2. If the ball bounces off a side wall and still goes in, that basket is worth ×2 with one bounce, ×3 with three bounces, and so on. All the multipliers add up.',
  },
  {
    q: 'Can I lose my progress?',
    a: 'The level you unlocked is saved on your phone. If you clear the app data or uninstall the game, it starts again from level 1. There is no cloud save.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. The game has no internet permission, no ads and no in-app purchases.',
  },
  {
    q: 'Which phones does it work on?',
    a: 'Android 7 or newer, on a 64-bit phone. The game is portrait only.',
  },
  {
    q: 'How do I turn off vibration?',
    a: 'The game vibrates a little when you score, when the ball hits the rim and when time runs out. You can turn off vibration in Android Settings → Sound and vibration.',
  },
];
---
<Layout title="Support – SWISH" description="Help, frequently asked questions and contact details for the SWISH basketball game.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Support</p>
      <h1>How can we help?</h1>
      <p class="lede">Answers to the usual questions, and an email address if you need help.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2 style="margin-top: 0;">Frequently asked</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <h2>Report a bug or ask for a feature</h2>
      <p>Write an email. Tell us your phone model, your Android version, and what happened. Screenshots help.</p>
      <div class="contact-card">
        <div>
          <h2>Write to us</h2>
          <p>We usually answer in a couple of days.</p>
        </div>
        <a class="button button-primary" href="mailto:emavgl.app@gmail.com?subject=SWISH%20support">emavgl.app@gmail.com</a>
      </div>

      <h2>Useful links</h2>
      <ul>
        <li><a href={playUrl} target="_blank" rel="noopener">SWISH on Google Play</a></li>
        <li><a href={`${base}privacy-policy/`}>Privacy policy</a> — nothing leaves your phone</li>
        <li><a href={`${base}data-safety/`}>Data safety</a> — the Play summary in simple words</li>
        <li><a href={`${base}content-rating/`}>Content rating</a> — what the game contains</li>
        <li><a href={`${base}impressum/`}>Impressum</a> — who makes the game</li>
      </ul>

      <p class="small-note">SWISH is developed by Emanuele Viglianisi, Leonding, Austria.</p>
    </div>
  </section>
</Layout>
