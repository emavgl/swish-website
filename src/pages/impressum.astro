---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Impressum – SWISH" description="Provider information for the SWISH website and game.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Legal information</p>
      <h1>Impressum.</h1>
      <p class="lede">Provider information for this website and the SWISH game.</p>
    </div>
  </section>

  <section class="section">
    <article class="container prose">
      <h2>Media owner and service provider</h2>
      <address class="legal-address">
        <strong>Emanuele Viglianisi</strong><br />
        Altenbauerstraße 12<br />
        4060 Leonding<br />
        Austria
      </address>
      <dl class="legal-details">
        <dt>Email</dt>
        <dd><a href="mailto:emavgl.app@gmail.com">emavgl.app@gmail.com</a></dd>
        <dt>Responsible for content</dt>
        <dd>Emanuele Viglianisi, at the address stated above.</dd>
        <dt>App</dt>
        <dd>SWISH, package eu.viglianisi.swish</dd>
      </dl>

      <h2>Business activity</h2>
      <p>Development, provision and distribution of the SWISH game for Android, and operation of this website.</p>

      <h2>Consumer and legal information</h2>
      <p>This website is informational. It does not operate a checkout or process payments. The SWISH app and any third-party services remain subject to their applicable terms and licences. For data handling, see the <a href={`${base}privacy-policy/`}>Privacy policy</a>; for the game's content, see the <a href={`${base}content-rating/`}>Content rating</a> page.</p>

      <h2>Online dispute resolution</h2>
      <p>Consumers in the EU can use the European Commission's online dispute resolution platform. We are neither obliged nor willing to participate in dispute resolution proceedings before a consumer arbitration board.</p>

      <p class="small-note">Last updated: November 2026.</p>
    </article>
  </section>
</Layout>
